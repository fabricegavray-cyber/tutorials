<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_clicker.ClickerSystrayItem">
        <div class="o_menu_systray_item d-flex align-items-center mx-1">
            <span>Clicks: <t t-esc="state.clicks"/></span>
            <button class="btn btn-primary ms-2" t-on-click="increment">+1</button>
            <button class="btn btn-secondary ms-2" t-on-click="openGame">Open</button>
        </div>

    </t>
</templates>